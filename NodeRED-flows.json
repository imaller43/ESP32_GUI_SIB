    {
        "id": "7a910c94c8b8f1fd",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Global State Manager",
        "func": "let cache = flow.get(\"esp32_cache\") || { devices: {}, tg: {}, auto: {} };\nlet parts = msg.topic.split(\"/\");\nlet device = parts[1];\nlet type = parts.slice(2).join(\"/\");\nlet val = msg.payload.toString();\n\nlet selectedDevice = flow.get(\"selectedDevice\");\n\nlet msgDropdown = null;\nlet msgTg = null;\nlet msgAuto = null;\n\nif (type === \"status\") {\n    if (val === \"online\") cache.devices[device] = true;\n    else delete cache.devices[device];\n    \n    let options = Object.keys(cache.devices);\n    options.unshift(\"ALL MACHINE\"); // Always place ALL MACHINE at the top\n    msgDropdown = { options: options };\n} else if (type === \"telegram/enabled\") {\n    cache.tg[device] = val;\n    if (device === selectedDevice) {\n        msgTg = { payload: val };\n    }\n} else if (type === \"update/auto/status\") {\n    cache.auto[device] = val;\n    if (device === selectedDevice) {\n        msgAuto = { payload: val };\n    }\n}\n\nflow.set(\"esp32_cache\", cache);\nreturn [msgDropdown, msgTg, msgAuto];",
