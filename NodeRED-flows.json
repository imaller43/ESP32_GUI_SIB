    {
        "id": "37d88aea45c16227",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Target Device (TG)",
        "func": "let selectedDevice = flow.get(\"selectedDevice\");\nif (!selectedDevice) return null;\n\nif (selectedDevice === \"ALL MACHINE\") {\n    let cache = flow.get(\"esp32_cache\") || { devices: {} };\n    let msgs = [];\n    for (let device in cache.devices) {\n        msgs.push({\n            topic: `esp32/${device}/telegram/enabled/set`,\n            payload: msg.payload\n        });\n    }\n    return [msgs]; // Broadcasts to all online devices sequentially\n} else {\n    msg.topic = `esp32/${selectedDevice}/telegram/enabled/set`;\n    return msg;\n}",
        "outputs": 1,
        "x": 880,
