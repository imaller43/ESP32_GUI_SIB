    {
        "id": "format_set_counter",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Target Device (Set Count)",
        "func": "let selectedDevice = flow.get(\"selectedDevice\");\nif (!selectedDevice) return null;\n\n// Convert \"DI3\" to 3\nlet sInt = parseInt(msg.payload.sensor.replace(\"DI\", \"\"));\nlet jsonPayload = JSON.stringify({ sensor: sInt, count: msg.payload.count });\n\nif (selectedDevice === \"ALL MACHINE\") {\n    let cache = flow.get(\"esp32_cache\") || { devices: {} };\n    let msgs = [];\n    for (let device in cache.devices) {\n        msgs.push({\n            topic: `esp32/${device}/triggercount/set`,\n            payload: jsonPayload\n        });\n    }\n    return [msgs];\n} else {\n    msg.topic = `esp32/${selectedDevice}/triggercount/set`;\n    msg.payload = jsonPayload;\n    return msg;\n}",
