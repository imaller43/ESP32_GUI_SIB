    {
        "id": "function_telegram_format",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Format & Add Chat ID",
        "func": "// 1. Parse the incoming JSON safely\nlet doc;\nif (typeof msg.payload === \"object\") {\n    doc = msg.payload;\n} else {\n    try {\n        doc = JSON.parse(msg.payload.toString());\n    } catch (e) {\n        return null;\n    }\n}\n\n// 2. Inject default Chat ID for spontaneous alerts (Boot, Reject, OTA)\nif (!doc.chatId) {\n    doc.chatId = \"721886383\"; // Your Admin Chat ID\n}\n\nlet chatId = doc.chatId;\n\n// 3. Clear any pending command timeouts (so your bot doesn't get stuck)\nlet timeouts = flow.get(\"timeouts\") || {};\nif (timeouts[chatId]) {\n    clearTimeout(timeouts[chatId]);\n    delete timeouts[chatId];\n    flow.set(\"timeouts\", timeouts);\n}\n\n// 4. Format the final Telegram message\nlet finalMessage = doc.message;\nif (doc.device) {\n    // I left the \\n here so it matches your original style!\n    finalMessage = `[${doc.device}]\\n${doc.message}`;\n}\n\nmsg.payload = {\n    type: \"message\",\n    chatId: chatId,\n    content: finalMessage\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 560,
        "wires": [
            [
                "telegram_sender"
            ]
        ]
    },
