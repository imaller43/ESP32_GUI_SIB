        "id": "58f120211780d79d",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Update UI for Selected Device",
        "func": "let selectedDevice = msg.payload;\nflow.set(\"selectedDevice\", selectedDevice);\n\nlet cache = flow.get(\"esp32_cache\") || { tg: {}, auto: {} };\nlet msgTg = null;\nlet msgAuto = null;\n\nif (selectedDevice === \"ALL MACHINE\") {\n    // Visual default for switches when ALL is selected\n    msgTg = { payload: \"0\" };\n    msgAuto = { payload: \"0\" };\n} else {\n    msgTg = { payload: cache.tg[selectedDevice] || \"0\" };\n    msgAuto = { payload: cache.auto[selectedDevice] || \"0\" };\n}\n\nreturn [msgTg, msgAuto];",
