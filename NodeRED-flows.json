    {
        "id": "format_reset_counter",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Target Device (Reset Count)",
        "func": "let selectedDevice = flow.get(\"selectedDevice\");\nif (!selectedDevice) return null;\n\n// Convert \"DI3\" to 3\nlet sInt = parseInt(msg.payload.sensor.replace(\"DI\", \"\"));\nlet jsonPayload = JSON.stringify({ sensor: sInt });\n\nif (selectedDevice === \"ALL MACHINE\") {\n    let cache = flow.get(\"esp32_cache\") || { devices: {} };\n    let msgs = [];\n    for (let device in cache.devices) {\n        msgs.push({\n            topic: `esp32/${device}/triggercount/reset`,\n            payload: jsonPayload\n        });\n    }\n    return [msgs];\n} else {\n    msg.topic = `esp32/${selectedDevice}/triggercount/reset`;\n    msg.payload = jsonPayload;\n    return msg;\n}",
        "outputs": 1,
        "x": 850,
        "y": 160,
        "wires": [
            [
                "11a1921f5fa6543e"
            ]
        ]
    },
