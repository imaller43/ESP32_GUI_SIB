    {
        "id": "974a99e6049f5aa0",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Send Help Menu",
        "func": "msg.payload = {\n    type: 'message',\n    chatId: msg.payload.chatId,\n    content: \"ESP32 Fleet Commands\\n\\nUsage: /[command] [machineName]\\n\\nExample:\\n/status Machine1 — DI/DO states\\n/metrics Machine1 — Runtime, downtime, rejects\\n/health Machine1 — Temp, heap, WiFi, uptime, version no.\\n/do on 1 Machine1 — Turn DO 1 ON\\n/do off 1 Machine1 — Turn DO 1 OFF\\n/resetmetrics Machine1 — Reset all counters\\n/help — Show this menu\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 520,
        "wires": [
            [
                "telegram_sender"
            ]
        ]
    },
    {
        "id": "telegram_parser_v2",
        "type": "function",
        "z": "b429cc46560fc6a7",
        "name": "Parse Commands to MQTT",
        "func": "let fullText = msg.originalMessage.text || \"\";\nlet parts = fullText.trim().split(\" \");\nlet commandTyped = parts[0].replace(\"/\", \"\");\nlet targetDevice = \"\";\nlet mqttMsg = null;\nlet errorMsg = null;\n\nif (commandTyped === \"do\") {\n    if (parts.length < 4) {\n        errorMsg = {\n            payload: {\n                type: 'message',\n                chatId: msg.payload.chatId,\n                content: `⚠️ Please specify state, channel, and machine name.\\nExample: /do on 1 Machine1`\n            }\n        };\n        return [null, errorMsg, null];\n    }\n    let state = parts[1].toLowerCase();\n    let target = parts[2];\n    targetDevice = parts[3];\n\n    mqttMsg = {\n        topic: \"esp32/\" + targetDevice + \"/command\",\n        payload: JSON.stringify({\n            cmd: \"do\",\n            state: state,\n            target: parseInt(target),\n            chatId: msg.payload.chatId\n        })\n    };\n} else {\n    if (parts.length < 2 || parts[1] === \"\") {\n        errorMsg = {\n            payload: {\n                type: 'message',\n                chatId: msg.payload.chatId,\n                content: `⚠️ Please specify a machine name.\\nExample: /${commandTyped} Machine1`\n            }\n        };\n        return [null, errorMsg, null];\n    }\n    targetDevice = parts[1];\n\n    mqttMsg = {\n        topic: \"esp32/\" + targetDevice + \"/command\",\n        payload: JSON.stringify({\n            cmd: commandTyped,\n            chatId: msg.payload.chatId\n        })\n    };\n}\n\n// --- SMART TIMEOUT LOGIC ---\nlet chatId = msg.payload.chatId;\nlet timeouts = flow.get(\"timeouts\") || {};\n\nif (timeouts[chatId]) {\n    clearTimeout(timeouts[chatId]);\n}\n\ntimeouts[chatId] = setTimeout(() => {\n    node.send([null, null, {\n        payload: {\n            type: \"message\",\n            chatId: chatId,\n            content: `⚠️ No device named '${targetDevice}' detected, or the device is offline.`\n        }\n    }]);\n    \n    let t = flow.get(\"timeouts\") || {};\n    delete t[chatId];\n    flow.set(\"timeouts\", t);\n}, 3000); // 3 seconds timeout\n\nflow.set(\"timeouts\", timeouts);\n\nreturn [mqttMsg, null, null];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 460,
        "wires": [
            [
                "11a1921f5fa6543e"
            ],
            [
                "telegram_sender"
            ],
            [
                "telegram_sender"
            ]
        ]
    },
